{
  // Editor/type-check config. Mirrors the options in scripts/build.mjs so the
  // IDE sees all `namespace SkyShift` files as one program. The build itself
  // still compiles through scripts/build.mjs.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
